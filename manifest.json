{
  "manifest_version": 3,
  "name": "TabEcho - Save & Restore Tab Sessions",
  "version": "1.6.4",
  "description": "Save, name, and restore browser tab sessions with local-only storage",
  "permissions": [
    "tabs",
    "storage",
    "windows"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
